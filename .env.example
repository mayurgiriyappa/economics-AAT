# Required on a public deployment. Set a long, private PIN for host authentication.
HOST_PIN=your-secure-private-pin
PORT=3000
MAX_PARTICIPANTS=500

# Optional: Supabase PostgreSQL & Realtime Configuration for multi-device cloud persistence
# If provided, all classroom and jury state is stored in your Supabase Postgres database
# and synchronized across devices using Supabase Realtime WebSocket channels.
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Public environment variables (accessible in frontend if needed)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
